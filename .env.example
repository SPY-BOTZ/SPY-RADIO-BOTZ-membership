# Server Configuration
PORT=3000
NODE_ENV=development
WEBSITE_URL=http://localhost:3000

# Telegram Bot Credentials
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDefGHIjklMNOpqrSTUvwxyz

# Telegram API Credentials
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Telegram Channel
# Format: @channelname or -100123456789
TELEGRAM_CHANNEL_USERNAME=@your_channel_here

# SMS Gateway Configuration
# Options: msg91, fast2sms, twilio
SMS_PROVIDER=msg91
SMS_API_KEY=your_sms_api_key_here

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_secret

# PhonePe (Optional)
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_API_KEY=your_api_key

# Database (Future)
# DATABASE_URL=your_mongodb_uri_or_supabase_url

# Admin Credentials (Change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=spy@123
